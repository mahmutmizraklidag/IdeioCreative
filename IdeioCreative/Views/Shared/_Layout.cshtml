@using IdeioCreative.Seo
@using Microsoft.Extensions.Options
@inject IOptions<IdeioSeoOptions> IdeioSeoOptions
@inject SocialMetadataBuilder SocialMetadata
@inject IdeioCreative.Tools.ContactSecurityQuestionService ContactSecurityQuestionService
@{
    var slideSecurityQuestion = ContactSecurityQuestionService.CreateQuestion();
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] | İdeio Creative</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    @* <meta name="keywords" content="@ViewData["MetaKeywords"]" /> *@
    @await Html.PartialAsync("_SocialMeta", SocialMetadata.Create(ViewData, DataRequestModel.SiteSetting, Context.Request.Path.Value ?? "/"))
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    @if (ViewData["CanonicalPath"] is string canonicalPath && !string.IsNullOrWhiteSpace(canonicalPath))
    {
        <link rel="canonical" href="@IdeioSeoOptions.Value.Absolute(canonicalPath)" />
    }

    

    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/img/fav/dark-favicon-32x32.png")" media="(prefers-color-scheme: light)">
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/img/fav/dark-favicon-16x16.png")" media="(prefers-color-scheme: light)">
    <link rel="apple-touch-icon" href="@Url.Content("~/img/fav/dark-apple-touch-icon.png")" media="(prefers-color-scheme: light)">

    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/img/fav/light-favicon-32x32.png")" media="(prefers-color-scheme: dark)">
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/img/fav/light-favicon-16x16.png")" media="(prefers-color-scheme: dark)">
    <link rel="apple-touch-icon" href="@Url.Content("~/img/fav/light-apple-touch-icon.png")" media="(prefers-color-scheme: dark)">

    <link rel="manifest" href="@Url.Content("~/img/fav/site.webmanifest")">

    @if (ViewData["HeroImagePath"] is string heroImagePath)
    {
        <link rel="preload" as="image" href="@Url.Content(heroImagePath)" fetchpriority="high">
    }
    <link rel="stylesheet" href="@Url.Content("~/assets/css/site.bundle.min.css")" asp-append-version="true">
    @await RenderSectionAsync("Styles", required: false)
    <script src="@Url.Content("~/assets/js/site.bundle.min.js")" asp-append-version="true" defer></script>

