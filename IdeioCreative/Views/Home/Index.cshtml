@model HomePageViewModel
@{
    ViewData["CanonicalPath"] = "/";
    ViewData["IncludeLocalBusiness"] = true;
    ViewData["Title"] = string.IsNullOrEmpty(DataRequestModel.SiteSetting.MetaTitle) ? "Anasayfa" : DataRequestModel.SiteSetting.MetaTitle;
    ViewData["MetaDescription"] = string.IsNullOrEmpty(DataRequestModel.SiteSetting.MetaDescription) ? "Anasayfa İdeio Creative" : DataRequestModel.SiteSetting.MetaDescription;
    ViewData["MetaKeywords"] = string.IsNullOrEmpty(DataRequestModel.SiteSetting.Keywords) ? "Anasayfa İdeio Creative" : DataRequestModel.SiteSetting.Keywords;
}

<!-- Main start -->
<main class="main position-relative overflow-hidden" id="mains">

    <!-- Custom Line Shape -->
    <div class="line-shape cus-z-1 first w-100 h-100 d-flex flex-wrap"></div>
    <!-- Custom Line Shape -->
    <!-- Hero Section Version0 -->
    <section class="hero-section-version1 position-relative">
        <div class="hero-background-video" data-youtube-cover aria-hidden="true">
            <img class="hero-background-image" src="@Url.Content("~/assets/img/banner/hero-bg1.png")"
                 alt="İdeio Creative ajans tanıtımı" width="1920" height="946" loading="eager" fetchpriority="high">
            <iframe id="home-hero-youtube" class="hero-youtube-player youtube-player"
                    data-src="https://www.youtube.com/embed/vYmVAC5Gsc0?enablejsapi=1&amp;autoplay=1&amp;mute=1&amp;loop=1&amp;playlist=vYmVAC5Gsc0&amp;controls=0&amp;playsinline=1&amp;cc_load_policy=0&amp;rel=0&amp;disablekb=1&amp;fs=0"
                    title="İdeio Creative tanıtım videosu"
                    allow="autoplay; encrypted-media"
                    referrerpolicy="strict-origin-when-cross-origin"
                    tabindex="-1"></iframe>
        </div>
        <div class="container">
            <div class="row g-5 hero-content-row" >
                <div class="hero-v1-content position-relative">
            
                    
                </div>
            </div>
        </div>
        <div class="hero-sponsor" style="max-width:1920px !important; overflow: hidden;">
            <div class="marquee-wrapper">

                <div class="sponsor-inner marquee-content d-flex align-items-center gap-xxl-13 gap-xl-10 gap-lg-8 gap-md-6 gap-5 mb-xxl-10 mb-xl-7 mb-lg-6 mb-6">
                    @foreach (var item in DataRequestModel.References)
                    {
                        <div class="reference-logo-frame reference-logo-frame--plain">
                            <img src="@Url.Content($"~/img/{Uri.EscapeDataString(item.Image ?? string.Empty)}")" alt="@(string.IsNullOrWhiteSpace(item.Name) ? "Referans marka logosu" : $"{item.Name} logosu")" class="reference-logo-image" decoding="async" draggable="false">
                        </div>
                    }
                </div>

                <div class="sponsor-inner marquee-content d-flex align-items-center gap-xxl-13 gap-xl-10 gap-lg-8 gap-md-6 gap-5 mb-xxl-10 mb-xl-7 mb-lg-6 mb-6" aria-hidden="true">
                    @foreach (var item in DataRequestModel.References)
                    {
                        <div class="reference-logo-frame reference-logo-frame--plain">
                            <img src="@Url.Content($"~/img/{Uri.EscapeDataString(item.Image ?? string.Empty)}")" alt="@(string.IsNullOrWhiteSpace(item.Name) ? "Referans marka logosu" : $"{item.Name} logosu")" class="reference-logo-image" decoding="async" draggable="false">
                        </div>
                    }
                </div>

            </div>
        </div>
       
