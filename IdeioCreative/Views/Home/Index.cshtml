    <!-- Watch Version01 End -->
<!-- References Start -->
<section class="references-section pt-space pb-space position-relative overflow-hidden">
    <div class="container">

        <div class="references-header d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4 mb-xl-5">
            <div>
                <span class="references-subtitle">İş Ortaklarımız</span>
                <h3 class="references-title white-clr mb-0">Referanslarımız</h3>
            </div>

            <div class="references-nav d-flex align-items-center gap-2">
                <button type="button" class="references-prev references-nav-btn">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button type="button" class="references-next references-nav-btn">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>
        </div>

        @if (Model?.References != null && Model.References.Any())
        {
            <div class="swiper references-swiper">
                <div class="swiper-wrapper">
                    @foreach (var reference in Model.References)
                    {
                        <div class="swiper-slide">
                            <div class="reference-card">
                                <div class="reference-card-inner">
                                    <div class="reference-logo-wrap reference-logo-frame reference-logo-frame--plain">
                                        <img src="/img/@reference.Image"
                                             alt="@(string.IsNullOrWhiteSpace(reference.Name) ? "Referans marka logosu" : $"{reference.Name} logosu")"
                                             class="reference-logo reference-logo-image" />
                                    </div>

                                    
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="reference-empty text-center">
                <p class="mb-0">Henüz referans eklenmemiş.</p>
            </div>
        }
    </div>
</section>
<!-- References End -->





    <!-- Cmn Team version01 Start -->
    <section class=
        "team-version01 pt-space pb-space">
        <div class="container position-relative">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-5 mb-xxl-15 mb-xl-12 mb-lg-10 mb-md-10 mb-sm-10 mb-9">
                <div class="pricing-title">
                    <div class="radius-btn text-uppercase cmn-border d-inline-flex radius100 py-xxl-2 py-2 px-xxl-4 px-4 theme-clr gap-xxl-4 gap-3 mb-xxl-8 mb-xl-6 mb-5">
                        Ekibimiz
                        <span class="rot60 d-inline-block">
                            <i class="fas fa-arrow-up theme-clr"></i>
                        </span>
                    </div>
                    <h2 class="stitle">
                        Yaratıcı Ekibimizle Tanışın
                    </h2>
                </div>
                <a asp-controller="Team" asp-action="Index"
                   class="radius-btn d-inline-flex text-capitalize radius100 py-xxl-2 py-2 px-xxl-5 px-5 theme-border theme-clr gap-xxl-4 gap-3 mb-xxl-8 mb-xl-6 mb-5">
                    Hepsini Gör...
                </a>
            </div>
            <div class="row g-xxl-7 g-xl-5 g-4 justify-content-center">

                @{
                    int index = 1;
                }

                @foreach (var team in DataRequestModel.Teams)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-sm-6 mt-lg-18"
                         data-aos="fadein"
                         data-aos-duration="1400">

                        <div class="team-card01 tilt overflow-hidden"
                             style="border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 15px; padding: 20px;">

                            <div class="thumb overflow-hidden w-100 position-relative mb-xxl-7 mb-xl-6 mb-5">
                                <img src="/img/@team.Image" alt="@(string.IsNullOrWhiteSpace(team.Name) ? "İdeio Creative ekip üyesi" : $"{team.Name} portresi")" class="w-100" style="border-radius: 10px;">
                            </div>

                            <div class="content">
                                <span class="bspan-clr position-relative mb-xxl-4 mb-xxl-3 mb-3">
                                    @team.Position
                                </span>
                                <h5 class="white-clr">
                                    @team.Name
                                </h5>
                            </div>
                        </div>
                    </div>

                    index++;
                }

            </div>
        </div>
    </section>
    <!-- Cmn Team version01 End -->
<!-- Version01 BLog One Start -->
@if (Model?.Blog != null && Model.Blog.Any())
{
    <section class="home-blog-version1 pb-space pt-space">
        <div class="container zindex position-relative">

            <div class="d-flex align-items-center justify-content-between flex-wrap gap-5 mb-xxl-15 mb-xl-12 mb-lg-10 mb-md-10 mb-sm-10 mb-9">
                <div class="pricing-title">
                    <div class="radius-btn text-uppercase cmn-border d-inline-flex radius100 py-xxl-2 py-2 px-xxl-4 px-4 theme-clr gap-xxl-4 gap-3 mb-xxl-8 mb-xl-6 mb-5">
                        Son Yazılarımız
                        <span class="rot60 d-inline-block">
                            <i class="fas fa-arrow-up theme-clr"></i>
                        </span>
                    </div>
                </div>

                <a asp-controller="Blog"
                   asp-action="Index"
                   class="radius-btn d-inline-flex radius100 py-xxl-2 py-2 px-xxl-5 px-5 theme-border theme-clr gap-xxl-4 gap-3 mb-xxl-8 mb-xl-6 mb-5">
                    Tümünü Gör...
                </a>
            </div>

            <div class="row g-xxl-7 g-xl-6 g-4">
                @foreach (var item in Model.Blog)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="blog-widget-item">

                            <div class="thumb w-100 overflow-hidden mb-xxl-7 mb-xl-6 mb-4">
                                <img src="/img/@item.Image"
                                     alt="@item.Title"
                                     class="w-100 overflow-hidden">
                            </div>

                            <div class="blog-cont">
                                <div class="d-flex align-items-center gap-xxl-5 gap-xl-4 gap-3 mb-xxl-5 mb-xl-4 mb-3">
                                    <span class="bspan-clr">
                                        @item.CreatedAt.ToString(
                                            "dd MMM yyyy",
                                            new System.Globalization.CultureInfo("tr-TR")
                                        )
                                    </span>
                                </div>

                                <h5>
                                    <a asp-controller="Blog"
                                       asp-action="Detail"
                                       asp-route-slug="@item.Slug"
                                       class="white-clr">
                                        @item.Title
                                    </a>
                                </h5>
                            </div>

                        </div>
                    </div>
                }
            </div>

        </div>
    </section>
}
