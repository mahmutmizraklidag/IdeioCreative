  <!-- Main start -->
@model NotFoundPageViewModel
@{
    ViewData["Title"] = "Sayfa Bulunamadı";
    ViewData["MetaDescription"] = "Aradığınız sayfa bulunamadı. Hizmetlerimizi keşfedin, sitede arama yapın veya bizimle iletişime geçin.";
    ViewData["Robots"] = "noindex, follow";
    ViewData["HeroImagePath"] = "~/assets/img/banner/breadcrumnd-bg.png";
}
@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/recovery.min.css")" asp-append-version="true" />
}
<main class="main">

    <!-- Breadcrumnd Banner -->
    <section class="breadcrumnd-banner position-relative">
        <div class="container">
            <div class="row g-5 justify-content-center">
                <div class="col-lg-5">
                    <div class="breadcrumnd-content text-center">
                        <h1 class="white mb-xxl-10 mb-xl-8 mb-6" data-aos="zoom-in-left" data-aos-duration="1800">
                            Sayfa Bulunamadı
                        </h1>
                        <ul class="breadcrumnd d-inline-flex align-items-center gap-2 pra-border radius100 py-xxl-3 py-2 px-xxl-4 px-4"
                            data-aos="zoom-in-right" data-aos-duration="2000">
                            <li>
                                <a asp-controller="Home" asp-action="Index" class="text-uppercase htheme">
                                    Anasayfa
                                </a>
                            </li>
                            <li>
                                <span class="rot60 d-inline-block">
                                    <i class="fas fa-arrow-up"></i>
                                </span>
                            </li>
                            <li class="theme-clr">
                                Sayfa Bulunamadı
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!--Element-->
        <img src="@Url.Content("~/assets/img/element/cmn-dost.png")" alt="Dekoratif nokta deseni" class="cmn-dots">
        <div class="cmn-svg-shape cmn-svg">
            <svg width="280" height="280" viewBox="0 0 211 211" fill="none"
                 xmlns="http://www.w3.org/2000/svg">

                <!-- Üst bar -->
                <rect x="80" y="18" width="51" height="18"
                      fill="url(#paint0_linear_6584_3026)" />

                <!-- Konuşma balonu -->
                <path d="M20 60 H191 V170 H105 L55 200 V170 H20 Z"
                      stroke="url(#paint0_linear_6584_3026)"
                      stroke-width="12"
                      fill="none" />

                <!-- Ortadaki halka -->
                <circle cx="105.5"
                        cy="118"
                        r="34"
                        stroke="url(#paint0_linear_6584_3026)"
                        stroke-width="14"
                        fill="none" />

                <defs>
                    <linearGradient id="paint0_linear_6584_3026"
                                    x1="416.867" y1="-216.267"
                                    x2="8.49998" y2="192.1"
                                    gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#E3FF04" />
                        <stop offset="1" stop-color="#FF7425" stop-opacity="0" />
                    </linearGradient>
                </defs>
            </svg>

        </div>
    </section>
    <!-- Breadcrumnd Banner -->
    <!-- Error Oops Start -->
    <section class="blog-grid pt-space pb-space">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8">
                    <div class="error-content text-center">
                        <div class="thumb recovery-illustration mb-6" data-aos="zoom-in"
                             data-aos-duration="1400">
                            <img src="@Url.Content("~/assets/img/error/opps.png")" alt="404: Aradığınız sayfa bulunamadı" class="w-100">
                        </div>
                        <h2 class="white-clr mb-xxl-7 mb-xl-6 mb-5">
                            Aradığınız sayfayı bulamadık
                        </h2>
                        <p class="white-clr mb-xxl-12 mb-xl-9 mb-lg-8 mb-5">
                            Sayfa taşınmış veya kaldırılmış olabilir. Arama yapabilir ya da aşağıdaki bağlantılardan devam edebilirsiniz.
                        </p>
                        <div class="recovery-panel text-start">
                            <form asp-controller="Search" asp-action="Index" method="get" role="search" class="site-search-form">
                                <label for="recovery-search" class="white-clr">Sitede ara</label>
                                <div class="site-search-controls">
                                    <input id="recovery-search" type="search" name="q" required
                                           maxlength="@SearchPageViewModel.MaxQueryLength"
                                           placeholder="Hizmet veya blog yazısı arayın" />
                                    <button type="submit" class="site-search-submit">
                                        <i class="fas fa-search" aria-hidden="true"></i> Ara
                                    </button>
                                </div>
                            </form>

                            <nav class="recovery-services" aria-labelledby="recovery-services-title">
                                <h3 id="recovery-services-title" class="white-clr">Hizmetlerimizi keşfedin</h3>
                                <ul class="recovery-links">
                                    @foreach (var service in Model.Services)
                                    {
                                        <li>
                                            <a asp-controller="Service" asp-action="Detail" asp-route-slug="@service.Slug">
                                                @service.Title <i class="fas fa-arrow-right" aria-hidden="true"></i>
                                            </a>
                                        </li>
                                    }
                                    <li><a asp-controller="Service" asp-action="Index">Tüm hizmetlerimiz <i class="fas fa-arrow-right" aria-hidden="true"></i></a></li>
                                </ul>
                            </nav>

                            <div class="recovery-contact">
                                <p class="pra-clr">Birlikte doğru çözümü bulalım.</p>
                                @if (!string.IsNullOrWhiteSpace(Model.PhoneNumber))
                                {
                                    <a class="recovery-phone" href="tel:@Model.PhoneNumber">
                                        <i class="fas fa-phone" aria-hidden="true"></i>
                                        <span><span class="recovery-phone-label">Bizi arayın</span>@Model.Phone</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="Contact" asp-action="Index" class="theme-clr">Bizimle iletişime geçin</a>
                                }
                            </div>
                        </div>
                        <a asp-controller="Home" asp-action="Index" class="recovery-home-link theme-clr">Anasayfaya dön <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Error Oops End -->

</main>
<!-- Main End -->
