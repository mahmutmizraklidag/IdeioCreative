@model Reference

@{
    ViewData["Title"] = "Slider Düzenle";
}

<div class="container mt-5">
    <div class="card shadow border-0 rounded-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h1 class="h4 mb-0"><i class="bi bi-journal-plus me-2"></i>Referans Düzenle</h1>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="bi bi-arrow-left"></i> Geri Dön
            </a>
        </div>

        <div class="card-body">
            <form asp-action="Edit" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Ad Soyad giriniz" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>


                  

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check mt-4">
                            <input class="form-check-input" asp-for="IsHome" />
                            <label class="form-check-label fw-semibold">@Html.DisplayNameFor(model => model.IsHome)</label>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Language" class="form-label fw-semibold"></label>
                        <select asp-for="Language" class="form-select" asp-items="Html.GetEnumSelectList<Language>()"></select>
                        <span asp-validation-for="Language" class="text-danger small"></span>
                    </div>



                    <div class="col-md-12">
                        <label asp-for="Image" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Image" type="file" class="form-control" id="imageInput" accept="image/png,image/webp" />
                        </div>
                        <div class="alert alert-info py-2 px-3 mt-2 mb-0 small">
                            <strong>Logo standardı:</strong> 600 × 240 px şeffaf PNG veya WebP.
                            Logoyu ortalayın ve 520 × 160 px güvenli alan içinde tutun
                            (her kenarda 40 px boşluk).
                        </div>
                        <div id="imageSizeMessage" class="small mt-2"></div>
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <div class="mb-3">
                                <label class="small text-muted d-block mb-1">Mevcut Görsel:</label>
                                <div class="rounded border bg-dark p-2" style="width: 300px; max-width: 100%; aspect-ratio: 5 / 2;">
                                    <img src="/img/@Model.Image" alt="@(string.IsNullOrWhiteSpace(Model.Name) ? "Referans logosu" : Model.Name)" class="w-100 h-100" style="object-fit: contain;" />
                                </div>
                            </div>
                        }
                        <div class="mt-2">
                            <div class="rounded border bg-dark p-2" style="width: 300px; max-width: 100%; aspect-ratio: 5 / 2;">
                                <img id="previewImage" src="#" alt="Önizleme" class="d-none w-100 h-100" style="object-fit: contain;" />
                            </div>
                        </div>
                        <span asp-validation-for="Image" class="text-danger small"></span>
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-1"></i> Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Görsel önizleme
        document.getElementById("imageInput").addEventListener("change", function (event) {
            const [file] = event.target.files;
            const preview = document.getElementById("previewImage");
            const message = document.getElementById("imageSizeMessage");
            if (file) {
                preview.src = URL.createObjectURL(file);
                preview.classList.remove("d-none");
                preview.onload = function () {
                    const isValidSize = preview.naturalWidth === 600 && preview.naturalHeight === 240;
                    event.target.setCustomValidity(isValidSize ? "" : "Logo görseli 600 × 240 px olmalıdır.");
                    message.className = isValidSize ? "small mt-2 text-success" : "small mt-2 text-danger";
                    message.textContent = isValidSize
                        ? "Ölçü uygun: 600 × 240 px"
                        : `Geçersiz ölçü: ${preview.naturalWidth} × ${preview.naturalHeight} px. Görsel 600 × 240 px olmalıdır.`;
                };
            } else {
                preview.classList.add("d-none");
                event.target.setCustomValidity("");
                message.textContent = "";
            }
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const editor = new Jodit('#AboutEditor', {
                height: 400,
                maxLength: 10000
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
