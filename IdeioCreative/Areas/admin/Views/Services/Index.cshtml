@model IEnumerable<Service>

@{
    ViewData["Title"] = "Hizmet ve Sektör Yönetimi";
}

@inject Microsoft.Extensions.Options.IOptions<IdeioCreative.Seo.IdeioSeoOptions> SeoOptions


<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 fw-bold text-primary mb-0">
            <i class="bi bi-journal-text me-2"></i> Hizmet ve Sektör Yönetimi
        </h1>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Yeni Sayfa Ekle
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body">
            <div class="d-flex justify-content-between mb-3">
                <div class="input-group" style="max-width: 300px;">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" id="searchInput" class="form-control" placeholder="Hizmet veya sektör ara...">
                </div>
                <span class="text-muted small align-self-center">@Model.Count() kayıt bulundu</span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Görsel</th>
                            <th>Başlık</th>
                            <th>Sayfa türü</th>
                           
                            <th>Slug</th>
                            <th>Dil</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="blogTable">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Image))
                                    {
                                        <img src="/img/@item.Image" alt="@(string.IsNullOrWhiteSpace(item.Title) ? "Sayfa görseli" : item.Title)" class="rounded" width="60" height="40" style="object-fit: cover;">
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Yok</span>
                                    }
                                </td>
                                <td class="fw-semibold">@item.Title</td>
                                <td>
                                    @if (item.PageType == ServicePageType.Sector)
                                    {
                                        <span class="badge bg-info text-dark">Sektör</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">Hizmet</span>
                                    }
                                </td>
                               
                                <td>@item.Slug</td>
                                <td>@item.Language</td>
                                <td class="text-end">
                                    <a href="@SeoOptions.Value.ServiceUrl(item)" class="btn btn-sm btn-outline-secondary me-1" title="Sayfayı görüntüle" target="_blank" rel="noopener">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i><span class="visually-hidden">Sayfayı görüntüle</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                   
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Basit tablo arama
        document.getElementById("searchInput").addEventListener("keyup", function () {
            var value = this.value.toLowerCase();
            var rows = document.querySelectorAll("#blogTable tr");
            rows.forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(value) ? "" : "none";
            });
        });
    </script>
}
